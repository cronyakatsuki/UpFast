#!/bin/bash

NAME=upfast
# USER=upfast
# GROUP=upfast
WORKERS=3
WORKER_CLASS=uvicorn.workers.UvicornWorker
VENV=.venv/bin/activate
BIND=unix:/tmp/upfast.lock
LOG_LEVEL=error

source $VENV

exec gunicorn main:app \
  --name $NAME \
  --workers $WORKERS \
  --worker-class $WORKER_CLASS \
  --bind=$BIND \
  --log-level=$LOG_LEVEL \
  --log-file=-
  # --user=$USER \
  # --group=$GROUP \
